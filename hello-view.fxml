                                        <Label text="R$ 419,00" styleClass="price"/>
                                        <Label text="por diária" styleClass="small"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Ver Detalhes  ❯" styleClass="details" onAction="#verDetalhes">
                                        <userData><String fx:value="Quarto Deluxe | Belo Horizonte – MG"/></userData>
                                    </Button>
                                </HBox>
                            </VBox>

                            <!-- QUARTO 8 -->
                            <VBox styleClass="room-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="10">
                                <padding>
                                    <Insets top="15" right="15" bottom="15" left="15"/>
                                </padding>

                                <ImageView fitWidth="390" fitHeight="185" preserveRatio="false" smooth="true">
                                    <image><Image url="@images/quarto2.png"/></image>
                                </ImageView>

                                <Label text="Fortaleza – CE" styleClass="location"/>
                                <Label text="Suíte Tropical" styleClass="room-title"/>
                                <Label text="Acomodação confortável para aproveitar dias ensolarados."
                                       wrapText="true" styleClass="description" minHeight="52"/>
                                <Label text="Café da manhã  •  Wi-Fi  •  TV" wrapText="true" styleClass="amenities"/>

                                <Region VBox.vgrow="ALWAYS"/>

                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <VBox spacing="3">
                                        <Label text="A partir de" styleClass="small"/>
                                        <Label text="R$ 549,00" styleClass="price"/>
                                        <Label text="por diária" styleClass="small"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Ver Detalhes  ❯" styleClass="details" onAction="#verDetalhes">
                                        <userData><String fx:value="Suíte Tropical | Fortaleza – CE"/></userData>
                                    </Button>
                                </HBox>
                            </VBox>

                            <!-- QUARTO 9 -->
                            <VBox styleClass="room-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="10">
                                <padding>
                                    <Insets top="15" right="15" bottom="15" left="15"/>
                                </padding>

                                <ImageView fitWidth="390" fitHeight="185" preserveRatio="false" smooth="true">
                                    <image><Image url="@images/quarto3.png"/></image>
                                </ImageView>

                                <Label text="Brasília – DF" styleClass="location"/>
                                <Label text="Quarto Conforto" styleClass="room-title"/>
                                <Label text="Espaço funcional e acolhedor para uma ótima estadia."
                                       wrapText="true" styleClass="description" minHeight="52"/>
                                <Label text="Ar-condicionado  •  TV  •  Wi-Fi" wrapText="true" styleClass="amenities"/>

                                <Region VBox.vgrow="ALWAYS"/>

                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <VBox spacing="3">
                                        <Label text="A partir de" styleClass="small"/>
                                        <Label text="R$ 329,00" styleClass="price"/>
                                        <Label text="por diária" styleClass="small"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Ver Detalhes  ❯" styleClass="details" onAction="#verDetalhes">
                                        <userData><String fx:value="Quarto Conforto | Brasília – DF"/></userData>
                                    </Button>
                                </HBox>
                            </VBox>

                        </HBox>

                        <!-- QUARTA LINHA DE HOSPEDAGENS -->
                        <HBox spacing="20" fillHeight="true">

                            <!-- QUARTO 10 -->
                            <VBox styleClass="room-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="10">
                                <padding>
                                    <Insets top="15" right="15" bottom="15" left="15"/>
                                </padding>

                                <ImageView fitWidth="390" fitHeight="185" preserveRatio="false" smooth="true">
                                    <image><Image url="@images/quarto1.png"/></image>
                                </ImageView>

                                <Label text="Recife – PE" styleClass="location"/>
                                <Label text="Quarto Família" styleClass="room-title"/>
                                <Label text="Espaço amplo para viagens em família com comodidades essenciais."
                                       wrapText="true" styleClass="description" minHeight="52"/>
                                <Label text="Frigobar  •  TV  •  Wi-Fi" wrapText="true" styleClass="amenities"/>

                                <Region VBox.vgrow="ALWAYS"/>

                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <VBox spacing="3">
                                        <Label text="A partir de" styleClass="small"/>
                                        <Label text="R$ 469,00" styleClass="price"/>
                                        <Label text="por diária" styleClass="small"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Ver Detalhes  ❯" styleClass="details" onAction="#verDetalhes">
