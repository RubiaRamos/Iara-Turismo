                                        <Label text="A partir de" styleClass="small"/>
                                        <Label text="R$ 529,00" styleClass="price"/>
                                        <Label text="por diária" styleClass="small"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Ver Detalhes  ❯" styleClass="details" onAction="#verDetalhes">
                                        <userData><String fx:value="Suíte Praia | Florianópolis – SC"/></userData>
                                    </Button>
                                </HBox>
                            </VBox>

                            <!-- QUARTO 6 -->
                            <VBox styleClass="room-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="10">
