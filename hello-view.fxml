<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.iara.HelloController"
            stylesheets="@style.css"
            prefWidth="1440"
            prefHeight="900"
            styleClass="root">

    <!-- CABEÇALHO -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="header">

            <padding>
                <Insets top="18" right="30" bottom="18" left="30"/>
            </padding>

            <Button text="☰"
                    onAction="#alternarMenu"
                    styleClass="menu-button"/>

            <Label text="Hotel Iara" styleClass="brand"/>

            <Label text="Sua rede de hotéis em todo o Brasil"
                   styleClass="tagline"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Olá, visitante" styleClass="user"/>

        </HBox>
    </top>

    <!-- CONTEÚDO PRINCIPAL -->
    <center>
        <StackPane>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        styleClass="scroll">

                <content>
                    <VBox spacing="24" styleClass="page">

                        <padding>
                            <Insets top="25" right="30" bottom="30" left="30"/>
                        </padding>

                        <!-- BANNER PRINCIPAL -->
                        <VBox spacing="10" styleClass="hero">

                            <padding>
                                <Insets top="25" right="30" bottom="25" left="30"/>
                            </padding>

                            <Label text="Hospedagens incríveis em todo o Brasil"
                                   styleClass="hero-title"/>

                            <Label text="Conforto, praticidade e a melhor localização para a sua viagem."
                                   styleClass="hero-subtitle"/>

                        </VBox>

                        <!-- BARRA DE PESQUISA -->
                        <HBox alignment="CENTER_LEFT"
                              spacing="15"
                              styleClass="search-bar">

                            <padding>
                                <Insets top="15" right="18" bottom="15" left="18"/>
                            </padding>

                            <TextField fx:id="campoDestino"
                                       promptText="Destino: Curitiba, RJ, Salvador..."
                                       HBox.hgrow="ALWAYS"/>

                            <DatePicker fx:id="checkIn"
                                        promptText="Check-in"/>

                            <DatePicker fx:id="checkOut"
                                        promptText="Check-out"/>

                            <Spinner fx:id="hospedes"
                                     editable="true"
                                     prefWidth="110"/>

                            <Button text="Buscar"
                                    onAction="#buscar"
                                    styleClass="details"/>

                        </HBox>

                        <!-- TÍTULO DAS HOSPEDAGENS -->
                        <HBox alignment="CENTER_LEFT">

                            <Label text="Opções de Hospedagem"
                                   styleClass="section-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="12 opções"
                                   styleClass="counter"/>

                        </HBox>

                        <!-- PRIMEIRA LINHA DE HOSPEDAGENS -->
                        <HBox spacing="20" fillHeight="true">

                            <!-- QUARTO 1 -->
                            <VBox styleClass="room-card"
                                  HBox.hgrow="ALWAYS"
                                  maxWidth="Infinity"
                                  spacing="10">

                                <padding>
                                    <Insets top="15" right="15" bottom="15" left="15"/>
                                </padding>

                                <ImageView fitWidth="390"
                                           fitHeight="185"
                                           preserveRatio="false"
                                           smooth="true">
                                    <image>
                                        <Image url="@images/quarto1.png"/>
]                                   </image>
                                </ImageView>

                                <Label text="Curitiba – PR" styleClass="location"/>
                                <Label text="Quarto Standard" styleClass="room-title"/>

                                <Label text="Quarto confortável com ar-condicionado, TV de tela plana, frigobar e banheiro privativo."
                                       wrapText="true"
                                       styleClass="description"
                                       minHeight="52"/>

                                <Label text="Ar-condicionado  •  TV  •  Frigobar"
                                       wrapText="true"
                                       styleClass="amenities"/>

                                <Region VBox.vgrow="ALWAYS"/>

                                <HBox alignment="CENTER_LEFT" spacing="8">

                                    <VBox spacing="3">
                                        <Label text="A partir de" styleClass="small"/>
                                        <Label text="R$ 299,00" styleClass="price"/>
                                        <Label text="por diária" styleClass="small"/>
                                    </VBox>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Button text="Ver Detalhes  ❯"
                                            styleClass="details"
                                            onAction="#verDetalhes">
                                        <userData>
                                            <String fx:value="Quarto Standard | Curitiba – PR"/>
                                        </userData>
                                    </Button>

                                </HBox>
                            </VBox>

                            <!-- QUARTO 2 -->
                            <VBox styleClass="room-card"
                                  HBox.hgrow="ALWAYS"
                                  maxWidth="Infinity"
                                  spacing="10">

                                <padding>
                                    <Insets top="15" right="15" bottom="15" left="15"/>
                                </padding>

                                <ImageView fitWidth="390"
                                           fitHeight="185"
                                           preserveRatio="false"
                                           smooth="true">
                                    <image>
                                        <Image url="@images/quarto2.png"/>
                                    </image>
                                </ImageView>

                                <Label text="Rio de Janeiro – RJ" styleClass="location"/>
                                <Label text="Quarto Superior" styleClass="room-title"/>

                                <Label text="Mais espaço e conforto, com varanda e vista privilegiada."
                                       wrapText="true"
                                       styleClass="description"
                                       minHeight="52"/>

                                <Label text="Ar-condicionado  •  TV  •  Café da manhã"
                                       wrapText="true"
                                       styleClass="amenities"/>

                                <Region VBox.vgrow="ALWAYS"/>

                                <HBox alignment="CENTER_LEFT" spacing="8">

                                    <VBox spacing="3">
                                        <Label text="A partir de" styleClass="small"/>
                                        <Label text="R$ 449,00" styleClass="price"/>
                                        <Label text="por diária" styleClass="small"/>
                                    </VBox>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Button text="Ver Detalhes  ❯"
                                            styleClass="details"
                                            onAction="#verDetalhes">
                                        <userData>
                                            <String fx:value="Quarto Superior | Rio de Janeiro – RJ"/>
                                        </userData>
                                    </Button>

                                </HBox>
                            </VBox>

                            <!-- QUARTO 3 -->
                            <VBox styleClass="room-card"
                                  HBox.hgrow="ALWAYS"
                                  maxWidth="Infinity"
                                  spacing="10">

                                <padding>
                                    <Insets top="15" right="15" bottom="15" left="15"/>
                                </padding>

                                <ImageView fitWidth="390"
                                           fitHeight="185"
                                           preserveRatio="false"
                                           smooth="true">
                                    <image>
                                        <Image url="@images/quarto3.png"/>
                                    </image>
                                </ImageView>

                                <Label text="Gramado – RS" styleClass="location"/>
