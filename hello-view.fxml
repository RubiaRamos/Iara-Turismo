                                        <userData><String fx:value="Quarto Executivo | São Paulo – SP"/></userData>
                                    </Button>
                                </HBox>
                            </VBox>

                        </HBox>

                        <!-- TERCEIRA LINHA DE HOSPEDAGENS -->
                        <HBox spacing="20" fillHeight="true">

                            <!-- QUARTO 7 -->
                            <VBox styleClass="room-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="10">
                                <padding>
                                    <Insets top="15" right="15" bottom="15" left="15"/>
                                </padding>

                                <ImageView fitWidth="390" fitHeight="185" preserveRatio="false" smooth="true">
                                    <image><Image url="@images/quarto3.png"/></image>
                                </ImageView>

                                <Label text="Belo Horizonte – MG" styleClass="location"/>
                                <Label text="Quarto Deluxe" styleClass="room-title"/>
                                <Label text="Quarto amplo com decoração moderna e banheiro privativo."
                                       wrapText="true" styleClass="description" minHeight="52"/>
                                <Label text="Ar-condicionado  •  TV  •  Frigobar" wrapText="true" styleClass="amenities"/>

                                <Region VBox.vgrow="ALWAYS"/>

                                <HBox alignment="CENTER_LEFT" spacing="8">
