                                       styleClass="description"
                                       minHeight="52"/>

                                <Label text="Ar-condicionado  •  Hidromassagem  •  TV"
                                       wrapText="true"
                                       styleClass="amenities"/>

                                <Region VBox.vgrow="ALWAYS"/>

                                <HBox alignment="CENTER_LEFT" spacing="8">

                                    <VBox spacing="3">
                                        <Label text="A partir de" styleClass="small"/>
                                        <Label text="R$ 799,00" styleClass="price"/>
                                        <Label text="por diária" styleClass="small"/>
