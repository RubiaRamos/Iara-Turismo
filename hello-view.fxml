            <!-- MENU LATERAL -->
            <VBox fx:id="menuLateral"
                  visible="false"
                  managed="false"
                  alignment="TOP_LEFT"
                  spacing="12"
                  maxWidth="250"
                  styleClass="side-menu"
                  StackPane.alignment="TOP_LEFT">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Navegação" styleClass="menu-heading"/>

                <Button text="Início" onAction="#irInicio"/>
                <Button text="Hospedagens" onAction="#irInicio"/>
                <Button text="Destinos"/>
                <Button text="Minhas Reservas"/>
                <Button text="Meu Perfil"/>
                <Button text="Sair"/>

