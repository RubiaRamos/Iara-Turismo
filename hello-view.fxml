                                    <image><Image url="@images/quarto2.png"/></image>
                                </ImageView>

                                <Label text="Foz do Iguaçu – PR" styleClass="location"/>
                                <Label text="Suíte Natureza" styleClass="room-title"/>
                                <Label text="Suíte tranquila com decoração elegante e área de descanso."
                                       wrapText="true" styleClass="description" minHeight="52"/>
                                <Label text="Ar-condicionado  •  TV  •  Café da manhã" wrapText="true" styleClass="amenities"/>

                                <Region VBox.vgrow="ALWAYS"/>

                                <HBox alignment="CENTER_LEFT" spacing="8">
