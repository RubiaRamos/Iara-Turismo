<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Tela de cadastro: mesma estrutura do login, com texto e botão diferentes. -->
<StackPane prefHeight="800.0" prefWidth="1280.0" styleClass="fundo-claro"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.hoteliara.controller.CadastroController">
    <padding>
        <Insets bottom="70.0" left="114.0" right="114.0" top="70.0" />
    </padding>

    <HBox styleClass="card-escuro">
        <VBox alignment="CENTER" prefWidth="500.0" spacing="34.0" HBox.hgrow="ALWAYS">
            <!-- Clicar na logo volta para o login -->
            <ImageView fx:id="logo" fitWidth="345.0" onMouseClicked="#onVoltar" pickOnBounds="true"
                       preserveRatio="true" styleClass="imagem-clicavel">
                <image>
                    <Image url="@../img/logo.png" />
                </image>
            </ImageView>
            <Label styleClass="rotulo-grande" text="Faça seu cadastro" />
            <padding>
                <Insets bottom="40.0" />
            </padding>
        </VBox>

        <Region maxWidth="3.0" minWidth="3.0" prefWidth="3.0" styleClass="divisor">
            <HBox.margin>
                <Insets bottom="10.0" />
            </HBox.margin>
        </Region>

        <VBox alignment="CENTER" prefWidth="500.0" HBox.hgrow="ALWAYS">
            <VBox maxWidth="420.0" prefWidth="420.0" spacing="6.0">
                <Label styleClass="rotulo-pequeno" text="Nome completo:" />
                <TextField fx:id="campoNome" styleClass="campo-pequeno" />

                <HBox spacing="14.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="rotulo-pequeno" text="CPF:" />
                        <TextField fx:id="campoCpf" promptText="000.000.000-00" styleClass="campo-pequeno" />
                    </VBox>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="rotulo-pequeno" text="Telefone:" />
                        <TextField fx:id="campoTelefone" promptText="(41) 99999-9999" styleClass="campo-pequeno" />
                    </VBox>
                </HBox>

                <Label styleClass="rotulo-pequeno" text="Data de nascimento:" />
                <DatePicker fx:id="campoNascimento" maxWidth="Infinity" styleClass="campo-data" />

                <Label styleClass="rotulo-pequeno" text="Email:" />
                <TextField fx:id="campoEmail" styleClass="campo-pequeno" />

                <Label styleClass="rotulo-pequeno" text="Senha (mínimo 6 caracteres):" />
                <PasswordField fx:id="campoSenha" onAction="#onCriar" styleClass="campo-pequeno" />

                <HBox alignment="CENTER" spacing="18.0">
                    <VBox.margin>
                        <Insets top="18.0" />
                    </VBox.margin>
                    <Button onAction="#onVoltar" styleClass="botao-contorno" text="Voltar" />
                    <Button onAction="#onCriar" styleClass="botao-creme" text="Criar" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
