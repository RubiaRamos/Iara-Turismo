<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Área do funcionário: reservas ativas de todos os hotéis e as ações sobre elas. -->
<VBox prefHeight="800.0" prefWidth="1280.0" styleClass="fundo-claro"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.hoteliara.controller.AdminController">

    <!-- Cabeçalho (a logo pequena volta para a pesquisa) -->
    <StackPane minHeight="150.0" prefHeight="150.0">
        <ImageView fitHeight="140.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="TOP_CENTER">
            <image>
                <Image url="@../img/titulo-hotel.png" />
            </image>
        </ImageView>
        <ImageView fitWidth="90.0" onMouseClicked="#onVoltar" pickOnBounds="true"
                   preserveRatio="true" styleClass="imagem-clicavel" StackPane.alignment="TOP_LEFT">
            <image>
                <Image url="@../img/logo.png" />
            </image>
            <StackPane.margin>
                <Insets left="31.0" top="25.0" />
            </StackPane.margin>
        </ImageView>
    </StackPane>

    <VBox spacing="14.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" />
        </padding>
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblTitulo" styleClass="titulo-tela" text="Área do funcionário" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblResumo" style="-fx-font-size: 15px;" />
        </HBox>

        <TableView fx:id="tabela" styleClass="tabela-reservas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNumero" prefWidth="45.0" text="Nº" />
                <TableColumn fx:id="colCliente" prefWidth="150.0" text="Cliente" />
                <TableColumn fx:id="colHotel" prefWidth="190.0" text="Hotel" />
                <TableColumn fx:id="colQuarto" prefWidth="170.0" text="Quarto" />
                <TableColumn fx:id="colPeriodo" prefWidth="210.0" text="Período" />
                <TableColumn fx:id="colStatus" prefWidth="105.0" text="Situação" />
                <TableColumn fx:id="colTotal" prefWidth="110.0" text="Total" />
                <TableColumn fx:id="colPago" prefWidth="110.0" text="Pago" />
                <TableColumn fx:id="colBoleto" prefWidth="110.0" text="Boleto" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-escuro">
            <padding>
                <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
            </padding>
            <Label styleClass="rotulo-pequeno" text="Reserva selecionada:" />
            <Button fx:id="btnConfirmar" onAction="#onConfirmar" styleClass="botao-contorno" text="Confirmar" />
            <Button fx:id="btnConcluir" onAction="#onConcluir" styleClass="botao-contorno" text="Concluir" />
            <Button fx:id="btnCancelar" onAction="#onCancelar" styleClass="botao-contorno" text="Cancelar" />
            <Button fx:id="btnBaixa" minWidth="170.0" onAction="#onBaixaBoleto" styleClass="botao-contorno" text="Baixa do boleto" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#onPesquisa" styleClass="botao-contorno" text="Pesquisa" />
            <Button onAction="#onSair" styleClass="botao-creme" text="Sair" />
        </HBox>
    </VBox>
</VBox>
