<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Lista de quartos: cabeçalho (logo + título) e 4 cards clicáveis. -->
<VBox prefHeight="800.0" prefWidth="1280.0" styleClass="fundo-claro"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.hoteliara.controller.QuartosController">

    <!-- Cabeçalho -->
    <StackPane minHeight="185.0" prefHeight="185.0">
        <ImageView fitHeight="168.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="TOP_CENTER">
            <image>
                <Image url="@../img/titulo-hotel.png" />
            </image>
        </ImageView>
        <ImageView fitWidth="98.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="TOP_LEFT">
            <image>
                <Image url="@../img/logo.png" />
            </image>
            <StackPane.margin>
                <Insets left="31.0" top="33.0" />
            </StackPane.margin>
        </ImageView>
    </StackPane>

    <!-- Cards: o id de cada card é usado pelo controller para saber qual foi clicado -->
    <HBox alignment="TOP_CENTER" spacing="20.0">
        <padding>
            <Insets left="30.0" right="30.0" />
        </padding>

        <VBox id="quarto1" alignment="TOP_CENTER" onMouseClicked="#onAbrirQuarto" prefHeight="345.0"
              prefWidth="290.0" spacing="38.0" styleClass="card-quarto" HBox.hgrow="ALWAYS">
            <padding>
                <Insets left="24.0" right="24.0" top="40.0" />
            </padding>
            <ImageView fx:id="foto1" fitWidth="242.0" preserveRatio="true">
                <image>
                    <Image url="@../img/quarto1.png" />
                </image>
            </ImageView>
            <Label styleClass="rotulo" text="Faça sua reserva" />
        </VBox>

        <VBox id="quarto2" alignment="TOP_CENTER" onMouseClicked="#onAbrirQuarto" prefHeight="345.0"
              prefWidth="290.0" spacing="38.0" styleClass="card-quarto" HBox.hgrow="ALWAYS">
            <padding>
                <Insets left="24.0" right="24.0" top="40.0" />
            </padding>
            <ImageView fx:id="foto2" fitWidth="242.0" preserveRatio="true">
                <image>
                    <Image url="@../img/quarto2.png" />
                </image>
            </ImageView>
            <Label styleClass="rotulo" text="Faça sua reserva" />
        </VBox>

        <VBox id="quarto3" alignment="TOP_CENTER" onMouseClicked="#onAbrirQuarto" prefHeight="345.0"
              prefWidth="290.0" spacing="38.0" styleClass="card-quarto" HBox.hgrow="ALWAYS">
            <padding>
                <Insets left="24.0" right="24.0" top="40.0" />
            </padding>
            <ImageView fx:id="foto3" fitWidth="242.0" preserveRatio="true">
                <image>
                    <Image url="@../img/quarto3.png" />
                </image>
            </ImageView>
            <Label styleClass="rotulo" text="Faça sua reserva" />
        </VBox>

        <VBox id="quarto4" alignment="TOP_CENTER" onMouseClicked="#onAbrirQuarto" prefHeight="345.0"
              prefWidth="290.0" spacing="38.0" styleClass="card-quarto" HBox.hgrow="ALWAYS">
            <padding>
                <Insets left="24.0" right="24.0" top="40.0" />
            </padding>
            <ImageView fx:id="foto4" fitWidth="242.0" preserveRatio="true">
                <image>
                    <Image url="@../img/quarto4.png" />
                </image>
            </ImageView>
            <Label styleClass="rotulo" text="Faça sua reserva" />
        </VBox>
    </HBox>
</VBox>
